# ===========================================================================
# ADNETIKS Environment Configuration
# Copy this file to `.env` for local/self-hosted runs, or set these variables
# in your cloud dashboard (Render, Railway, Fly.io, DigitalOcean, Coolify).
# ===========================================================================

# Server Port & Mode
PORT=3000
ADNETIKS_DEPLOY_MODE=cloud

# ---------------------------------------------------------------------------
# 1. AI Engine Selection (Provider-Agnostic)
# Options: gemini | openai | anthropic | openai_compatible
# Leave keys blank to run in zero-cost local Brand Engine mode.
# ---------------------------------------------------------------------------
ADNETIKS_LLM_PROVIDER=gemini
ADNETIKS_LLM_MODEL=

# Provide ONLY the key for the provider you want to use:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Free Local AI (Ollama) or Custom OpenAI-Compatible Host (Groq, Together)
# Example for Docker + Ollama sidecar: http://ollama:11434
# Example for local machine Ollama:    http://localhost:11434
ADNETIKS_API_BASE_URL=

# ---------------------------------------------------------------------------
# 2. Headless Website Scanner (Auto-detected on Windows, macOS & Docker)
# Only override if Chrome/Chromium is installed in a custom path.
# ---------------------------------------------------------------------------
# ADNETIKS_CHROME_PATH=/usr/bin/chromium

# ---------------------------------------------------------------------------
# 3. Public Base URL (used for UTM /r/ short links and conversion pixel)
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
